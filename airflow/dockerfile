# ============================================================
# SMYP – Airflow Dockerfile
# Brawn Dunel
# ============================================================

FROM apache/airflow:2.8.0

# Passe en root pour installer les dépendances système
USER root
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Repasse en user airflow pour installer les packages Python
USER airflow

# Copie et installe les dépendances Python du DAG
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# Commande de démarrage
CMD bash -c "\
    airflow db migrate && \
    airflow users create \
        --username ${AIRFLOW_USERNAME:-admin} \
        --password ${AIRFLOW_PASSWORD:-admin} \
        --firstname Brawn \
        --lastname Dunel \
        --role Admin \
        --email brawn@smyp.fr 2>/dev/null || true && \
    airflow webserver & \
    airflow scheduler \
"